# Custom Chromium Browser - v0.1 foundation
# This file defines project-level identity and build metadata.
# It is intentionally separate from Chromium/Cromite source so future
# feature patches can be added without mixing project configuration.

BROWSER_NAME=Custom Chromium Browser
BROWSER_SHORT_NAME=CCB
BROWSER_VERSION=0.1.0
BASE_ENGINE=Chromium
BASE_PRIVACY=Cromite
ANDROID_ABI=arm64-v8a
DRM_MODE=system-mediaserver
TELEMETRY_DEFAULT=disabled
